rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function member(code) {
      return signedIn() &&
        get(/databases/$(database)/documents/couples/$(code)).data.user1 != null &&
        get(/databases/$(database)/documents/couples/$(code)).data.user2 != null &&
        (!get(/databases/$(database)/documents/couples/$(code)).data.keys().hasAny(['status']) ||
         get(/databases/$(database)/documents/couples/$(code)).data.status == 'paired') &&
        (get(/databases/$(database)/documents/couples/$(code)).data.user1 == request.auth.uid ||
         get(/databases/$(database)/documents/couples/$(code)).data.user2 == request.auth.uid);
    }

    function validTextMessage(code) {
      return request.resource.data.keys().hasOnly([
          'type', 'text', 'uploadedBy', 'createdAt', 'timestamp', 'coupleId'
        ]) &&
        request.resource.data.type == 'text' &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000 &&
        request.resource.data.uploadedBy == request.auth.uid &&
        request.resource.data.coupleId == code &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.timestamp == request.time;
    }

    function validPhotoMessage(code) {
      return request.resource.data.keys().hasOnly([
          'type', 'storagePath', 'uploadedBy', 'createdAt', 'coupleCode',
          'fileName', 'contentType', 'sizeBytes', 'timestamp'
        ]) &&
        request.resource.data.type == 'image' &&
        request.resource.data.storagePath is string &&
        request.resource.data.storagePath ==
          'couples/' + code + '/photos/' + request.resource.data.fileName &&
        request.resource.data.fileName is string &&
        request.resource.data.fileName.size() > 0 &&
        request.resource.data.uploadedBy == request.auth.uid &&
        request.resource.data.coupleCode == code &&
        request.resource.data.contentType in ['image/jpeg', 'image/png', 'image/webp'] &&
        request.resource.data.sizeBytes is int &&
        request.resource.data.sizeBytes > 0 &&
        request.resource.data.sizeBytes <= 1 * 1024 * 1024 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.timestamp == request.time;
    }

    function validProfileName(value) {
      return value is string && value.size() > 0 && value.size() <= 80;
    }

    function validProfileDate(value) {
      return value is timestamp &&
        value >= timestamp.date(1900, 1, 1) && value <= request.time;
    }

    function validCharacterAppearance(value) {
      return value is map &&
        value.keys().hasOnly([
          'baseStyle', 'hairStyle', 'hairColor', 'skinTone', 'outfitStyle',
          'outfitColor', 'shoes', 'accessory', 'expression', 'pose'
        ]) &&
        value.keys().hasAll([
          'baseStyle', 'hairStyle', 'hairColor', 'skinTone', 'outfitStyle',
          'outfitColor', 'shoes', 'accessory', 'expression', 'pose'
        ]) &&
        value.baseStyle in ['classicBoy', 'classicGirl'] &&
        value.hairStyle in ['short', 'long', 'curls'] &&
        value.hairColor in ['brown', 'black', 'blonde', 'copper'] &&
        value.skinTone in ['light', 'warm', 'deep'] &&
        value.outfitStyle in ['casual', 'cozy', 'elegant'] &&
        value.outfitColor in ['rose', 'plum', 'blue', 'green'] &&
        value.shoes in ['sneakers', 'boots'] &&
        value.accessory in ['none', 'glasses', 'heartPin', 'headband'] &&
        value.expression in ['smile', 'calm', 'excited'] &&
        value.pose in ['idle', 'wave', 'sit'];
    }

    function validProfileCreate(userId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'displayName', 'birthday',
          'relationshipStartDate', 'profileTheme', 'profileCompleted',
          'photoStoragePath', 'createdAt', 'updatedAt', 'coupleCode',
          'pendingCoupleCode', 'characterAppearance'
        ]) &&
        (!request.resource.data.keys().hasAny(['uid']) ||
         request.resource.data.uid == userId) &&
        (!request.resource.data.keys().hasAny(['email']) ||
         request.resource.data.email is string &&
         request.resource.data.email.size() <= 254) &&
        (!request.resource.data.keys().hasAny(['name']) ||
         validProfileName(request.resource.data.name)) &&
        (!request.resource.data.keys().hasAny(['displayName']) ||
         validProfileName(request.resource.data.displayName)) &&
        (!request.resource.data.keys().hasAny(['birthday']) ||
         validProfileDate(request.resource.data.birthday)) &&
        (!request.resource.data.keys().hasAny(['relationshipStartDate']) ||
         validProfileDate(request.resource.data.relationshipStartDate)) &&
        (!request.resource.data.keys().hasAny(['profileTheme']) ||
         request.resource.data.profileTheme in ['rose', 'lavender', 'sunset']) &&
        (!request.resource.data.keys().hasAny(['characterAppearance']) ||
         validCharacterAppearance(request.resource.data.characterAppearance)) &&
        (!request.resource.data.keys().hasAny(['profileCompleted']) ||
         request.resource.data.profileCompleted is bool) &&
        (!request.resource.data.keys().hasAny(['photoStoragePath']) ||
         request.resource.data.photoStoragePath ==
           'profile_photos/' + userId + '.jpg') &&
        (!request.resource.data.keys().hasAny(['createdAt']) ||
         request.resource.data.createdAt == request.time) &&
        (!request.resource.data.keys().hasAny(['updatedAt']) ||
         request.resource.data.updatedAt == request.time) &&
        (!request.resource.data.keys().hasAny(['coupleCode']) ||
         request.resource.data.coupleCode == '') &&
        (!request.resource.data.keys().hasAny(['pendingCoupleCode']) ||
         request.resource.data.pendingCoupleCode == '');
    }

    function validProfileUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'uid', 'name', 'displayName', 'birthday', 'relationshipStartDate',
          'profileTheme', 'profileCompleted', 'photoStoragePath', 'updatedAt',
          'characterAppearance'
        ]) &&
        (!changed.hasAny(['uid']) ||
         (!resource.data.keys().hasAny(['uid']) &&
          request.resource.data.uid == userId)) &&
        (!changed.hasAny(['name']) || validProfileName(request.resource.data.name)) &&
        (!changed.hasAny(['displayName']) ||
         validProfileName(request.resource.data.displayName)) &&
        (!changed.hasAny(['birthday']) ||
         validProfileDate(request.resource.data.birthday)) &&
        (!changed.hasAny(['relationshipStartDate']) ||
         validProfileDate(request.resource.data.relationshipStartDate)) &&
        (!changed.hasAny(['profileTheme']) ||
         request.resource.data.profileTheme in ['rose', 'lavender', 'sunset']) &&
        (!changed.hasAny(['characterAppearance']) ||
         validCharacterAppearance(request.resource.data.characterAppearance)) &&
        (!changed.hasAny(['profileCompleted']) ||
         request.resource.data.profileCompleted is bool) &&
        (!changed.hasAny(['photoStoragePath']) ||
         request.resource.data.photoStoragePath ==
           'profile_photos/' + userId + '.jpg') &&
        (!changed.hasAny(['updatedAt']) ||
         request.resource.data.updatedAt == request.time);
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId &&
        validProfileCreate(userId);
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId &&
        validProfileUpdate(userId);

      match /devices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly([
            'token', 'platform', 'enabled', 'updatedAt'
          ]) &&
          request.resource.data.token is string &&
          request.resource.data.token.size() >= 20 &&
          request.resource.data.token.size() <= 4096 &&
          request.resource.data.platform == 'android' &&
          request.resource.data.enabled is bool &&
          request.resource.data.updatedAt == request.time;
      }

      match /settings/notifications {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly([
            'chatEnabled', 'quickMessagesEnabled', 'calendarEnabled',
            'hideSensitiveContent',
            'quietHoursEnabled', 'quietStartHour', 'quietEndHour', 'updatedAt'
          ]) &&
          request.resource.data.chatEnabled is bool &&
          request.resource.data.quickMessagesEnabled is bool &&
          request.resource.data.calendarEnabled is bool &&
          request.resource.data.hideSensitiveContent is bool &&
          request.resource.data.quietHoursEnabled is bool &&
          request.resource.data.quietStartHour is int &&
          request.resource.data.quietStartHour >= 0 &&
          request.resource.data.quietStartHour <= 23 &&
          request.resource.data.quietEndHour is int &&
          request.resource.data.quietEndHour >= 0 &&
          request.resource.data.quietEndHour <= 23 &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // Wellness data is sensitive and private by default. Only Cloud
      // Functions may mutate it; not even a partner can read this path.
      match /wellness/{documentId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /wellnessEntries/{entryId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
    }

    match /couples/{code} {
      // Creation and membership changes are atomic server operations.
      allow create: if false;

      allow read: if member(code) ||
        (signedIn() &&
         resource.data.user1 == request.auth.uid &&
         resource.data.user2 == null &&
         (!resource.data.keys().hasAny(['status']) ||
          resource.data.status == 'pending'));

      // Economy, identities and winner/reward fields are server-only.
      allow update: if member(code) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'coins', 'love', 'energy', 'plantsWatered', 'ownedGardenItems',
          'ownedInteriorItems', 'dailyChest', 'dailyMissions', 'user1',
          'user2', 'winner', 'winnerSide', 'rewardClaimed',
          'rewardClaimedAt', 'rewardClaimedBy', 'rewardGranted',
          'rewardedAt', 'rewardedTo', 'balances', 'code', 'createdBy',
          'status', 'inviteExpiresAt', 'consumedAt', 'consumedBy',
          'memberProfiles', 'memberPresence', 'memberProfilesUpdatedAt',
          'chatReadState', 'lastShopPurchase', 'gardenLayout',
          'gardenUpdatedAt', 'gardenRevision', 'selectedHouseId',
          'houseUpdatedAt', 'interiorLayout', 'interiorUpdatedAt',
          'interiorRevision', 'furniturePositions', 'gardenPlant'
        ]);

      match /chat/{messageId} {
        allow read: if member(code);
        allow create, update, delete: if false;
      }

      match /typing/{userId} {
        allow read: if member(code);
        allow create, update: if member(code) &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['uid', 'isTyping', 'updatedAt']) &&
          request.resource.data.uid == userId &&
          request.resource.data.isTyping is bool &&
          request.resource.data.updatedAt == request.time;
        allow delete: if member(code) && request.auth.uid == userId;
      }

      match /chatRateLimits/{userId} {
        allow read, write: if false;
      }

      match /games/{gameId} {
        allow read: if member(code);
        allow create, update, delete: if false;
      }

      match /actionClaims/{document=**} {
        allow read, write: if false;
      }

      match /missionClaims/{document=**} {
        allow read, write: if false;
      }

      match /gameRewardClaims/{document=**} {
        allow read, write: if false;
      }

      match /economyLedger/{entryId} {
        allow read: if member(code);
        allow create, update, delete: if false;
      }

      match /memories/{memoryId} {
        allow read: if member(code);
        allow create, update, delete: if false;
      }

      match /calendarEvents/{eventId} {
        allow read: if member(code);
        allow create, update, delete: if false;
      }

      // This collection contains only the small set of fields the owner
      // explicitly consented to share. Private notes never enter this path.
      match /wellnessShared/{ownerUid} {
        allow read: if member(code);
        allow create, update, delete: if false;
      }

      // Location is temporary, consent-based and written only by validated
      // server functions. Members can see only the current share document.
      match /locationShares/{ownerUid} {
        allow read: if member(code);
        allow create, update, delete: if false;
      }

      match /state/pet {
        allow read: if member(code);
        allow create, update, delete: if false;
      }

      match /state/{document=**} {
        allow read: if member(code);
        allow write: if false;
      }

      match /cinemaReactions/{document=**} {
        allow read, write: if member(code);
      }

      match /cinemaMessages/{document=**} {
        allow read, write: if member(code);
      }

      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    match /{unknownPath=**} {
      allow read, write: if false;
    }
  }
}
